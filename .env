# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:AAAA-your-bot-token-here

# ID администраторов через запятую (можно узнать через @userinfobot). Пусто = доступ всем.
ADMIN_IDS=111111111,222222222

# ID чата/пользователя, куда бот шлёт уведомления (о совпадениях в чатах и заказах Kwork)
NOTIFY_CHAT_ID=111111111

# Минимальная цена заказа Kwork для уведомления (0 = без ограничения)
MIN_PRICE=500

# Рабочее время для уведомлений (формат HH:MM, поддерживает ночной диапазон вида 22:00-06:00)
WORK_START=09:00
WORK_END=21:00

# Интервал проверки Kwork в секундах
KWORK_CHECK_INTERVAL=300

# Логин/пароль Kwork (опционально, пароль шифруется в памяти через Fernet)
KWORK_LOGIN=
KWORK_PASSWORD=

# HTTP(S)-прокси для запросов к Telegram/Kwork (по умолчанию отключено)
PROXY_URL=

# Пути к файлам данных и логов (можно оставить по умолчанию)
DATA_FILE=data.json
LOG_FILE=bot.log
